---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RightSidebar from "@/components/RightSidebar.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const API = "https://radar.xiaozha.org";

// Build-time snapshot for SEO; the client refreshes live data on load.
let items: any[] = [];
let stats: any = null;
try {
  const [itemsRes, statsRes] = await Promise.all([
    fetch(`${API}/api/items?limit=24`),
    fetch(`${API}/api/stats`),
  ]);
  if (itemsRes.ok) items = (await itemsRes.json()).items ?? [];
  if (statsRes.ok) stats = await statsRes.json();
} catch {
  // Network unavailable: keep an empty snapshot, the client will retry.
}

const categoryNames: Record<string, string> = {
  ai: "AI", game: "Games", news: "News", vps: "VPS", pan: "Cloud Drive", tech: "Tech",
  software: "Software", media: "Media", lottery: "Giveaways", goods: "Deals", opensource: "Open Source",
  finance: "Finance", stock: "Stocks", hardware: "Hardware", domain: "Domains", cloud: "Cloud",
  offline: "Offline", edu: "Education", invite: "Invites", carpool: "Carpool", dev: "Dev",
  trade: "Trading", design: "Design", security: "Security", other: "Other",
};
const categories = (stats?.byCategory ?? []).map((c: any) => ({
  key: c.category,
  label: categoryNames[c.category] ?? c.category,
  n: c.n,
}));

const total = stats?.totals?.total ?? 0;
const last24h = stats?.totals?.last24h ?? 0;
---

<Layout
  title={`Deal Radar | ${SITE.titleEn}`}
  description="AI tools, promo codes, free tiers, VPS deals and more — scraped from across the web every day and organized by category."
  altURL="/radar/"
>
  <Header locale="en" />
  <div class="layout">
    <main>
      <div class="radar-head">
        <h1 class="page-title">🎁 Deal Radar</h1>
        <p class="page-desc">AI tools, promo codes, free tiers, VPS and cloud drive deals, collected and organized for you every day.</p>
        <div class="stat-row">
          <span><strong>{total || "—"}</strong> deals tracked</span>
          <span class="dot"></span>
          <span><strong>{last24h || "—"}</strong> in 24h</span>
          <span class="dot"></span>
          <span>{categories.length || 25} categories</span>
        </div>
        <p class="source-note">Powered by <a href={API} target="_blank" rel="noopener noreferrer">Resource Radar</a> · refreshed every 30 minutes</p>
      </div>

      <div class="toolbar">
        <div class="category-tabs" id="cat-tabs">
          <button class="cat-tab active" data-cat="">All</button>
          {categories.map((c) => (
            <button class="cat-tab" data-cat={c.key}>{c.label} <span class="cat-n">{c.n}</span></button>
          ))}
        </div>
        <div class="search-row">
          <input id="radar-search" type="search" placeholder="Search titles, summaries or tags…" autocomplete="off" />
          <span id="result-count" class="result-count"></span>
        </div>
      </div>

      <div id="radar-list" class="radar-list">
        {items.map((it) => (
          <article class="deal-card" data-cat={it.category}>
            <div class="deal-body">
              <div class="deal-meta">
                <span class="deal-cat">{categoryNames[it.category] ?? it.category}</span>
                {it.is_free === 1 && <span class="badge-free">Free</span>}
                {it.price && <span class="deal-price">{it.price}</span>}
                <span class="dot"></span>
                <span>{it.source_id}</span>
                {it.published_at && <><span class="dot"></span><time>{new Date(it.published_at).toLocaleDateString("en-US", { month: "numeric", day: "numeric" })}</time></>}
              </div>
              <h2><a href={it.url} target="_blank" rel="noopener noreferrer">{it.title}</a></h2>
              {it.summary && <p class="deal-desc">{it.summary}</p>}
              {it.tags?.length > 0 && (
                <div class="deal-tags">{it.tags.slice(0, 5).map((tag: string) => <span class="deal-tag">#{tag}</span>)}</div>
              )}
              {it.codes?.length > 0 && (
                <div class="deal-codes">{it.codes.map((code: string) => <code>{code}</code>)}</div>
              )}
            </div>
          </article>
        ))}
      </div>

      <div id="empty" class="empty" style={items.length ? "display:none" : ""}>No matches. Try another keyword.</div>
      <div class="load-more-wrap">
        <button id="load-more" class="load-more" disabled>Load more</button>
      </div>
    </main>
    <RightSidebar locale="en" />
  </div>
  <Footer />
</Layout>

<script define:vars={{ API, categoryNames }}>
  const listEl = document.getElementById("radar-list");
  const tabsEl = document.getElementById("cat-tabs");
  const searchEl = document.getElementById("radar-search");
  const countEl = document.getElementById("result-count");
  const emptyEl = document.getElementById("empty");
  const moreBtn = document.getElementById("load-more");

  // Dynamically rendered cards lack Astro's scoped attribute; restore it to reuse this page's styles.
  const cidAttr = [...listEl.attributes].find((a) => a.name.startsWith("data-astro-cid-"));
  function applyScoped(root) {
    if (!cidAttr) return;
    [root, ...root.querySelectorAll("*")].forEach((n) => n.setAttribute(cidAttr.name, cidAttr.value));
  }

  const state = { cat: "", keyword: "", offset: 0, total: 0, loading: false };
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const catName = (k) => categoryNames[k] || k;

  function cardHTML(it) {
    const tags = (it.tags || []).slice(0, 5).map((t) => `<span class="deal-tag">#${esc(t)}</span>`).join("");
    const codes = (it.codes || []).map((c) => `<code>${esc(c)}</code>`).join("");
    const date = it.published_at ? new Date(it.published_at).toLocaleDateString("en-US", { month: "numeric", day: "numeric" }) : "";
    return `<article class="deal-card" data-cat="${esc(it.category)}">
      <div class="deal-body">
        <div class="deal-meta">
          <span class="deal-cat">${catName(it.category)}</span>
          ${it.is_free === 1 ? '<span class="badge-free">Free</span>' : ""}
          ${it.price ? `<span class="deal-price">${esc(it.price)}</span>` : ""}
          <span class="dot"></span><span>${esc(it.source_id)}</span>
          ${date ? `<span class="dot"></span><time>${date}</time>` : ""}
        </div>
        <h2><a href="${esc(it.url)}" target="_blank" rel="noopener noreferrer">${esc(it.title)}</a></h2>
        ${it.summary ? `<p class="deal-desc">${esc(it.summary)}</p>` : ""}
        ${tags ? `<div class="deal-tags">${tags}</div>` : ""}
        ${codes ? `<div class="deal-codes">${codes}</div>` : ""}
      </div>
    </article>`;
  }

  function render(items, append) {
    if (!append) {
      listEl.innerHTML = items.map(cardHTML).join("");
      applyScoped(listEl);
    } else {
      const before = listEl.children.length;
      listEl.insertAdjacentHTML("beforeend", items.map(cardHTML).join(""));
      for (let i = before; i < listEl.children.length; i++) applyScoped(listEl.children[i]);
    }
    emptyEl.style.display = listEl.children.length ? "none" : "block";
    countEl.textContent = state.total ? `${state.total} deals` : "";
    moreBtn.disabled = state.offset >= state.total;
    moreBtn.textContent = state.offset >= state.total ? "All loaded" : "Load more";
  }

  async function load(append = false) {
    if (state.loading) return;
    state.loading = true;
    moreBtn.disabled = true;
    moreBtn.textContent = "Loading…";
    try {
      const params = new URLSearchParams({ limit: "24", offset: String(state.offset) });
      if (state.cat) params.set("category", state.cat);
      const res = await fetch(`${API}/api/items?${params}`);
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      state.total = data.total;
      state.offset += (data.items || []).length;
      render(data.items || [], append);
    } catch {
      if (!append) {
        emptyEl.style.display = "block";
        emptyEl.textContent = "Live data unavailable — showing the last build-time snapshot.";
      }
    } finally {
      state.loading = false;
      moreBtn.disabled = state.offset >= state.total;
      if (state.offset < state.total) moreBtn.textContent = "Load more";
      else if (state.total) moreBtn.textContent = "All loaded";
    }
  }

  tabsEl.addEventListener("click", (e) => {
    const btn = e.target.closest(".cat-tab");
    if (!btn || btn.dataset.cat === state.cat) return;
    tabsEl.querySelectorAll(".cat-tab").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    state.cat = btn.dataset.cat;
    state.offset = 0;
    load(false);
  });

  let timer;
  searchEl.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const keyword = searchEl.value.trim().toLowerCase();
      const cards = [...listEl.children];
      cards.forEach((c) => {
        const t = c.querySelector("h2")?.textContent || "";
        const d = c.querySelector(".deal-desc")?.textContent || "";
        const tags = [...c.querySelectorAll(".deal-tag")].map((x) => x.textContent).join(" ");
        c.style.display = !keyword || (t + d + tags).toLowerCase().includes(keyword) ? "" : "none";
      });
      emptyEl.style.display = cards.some((c) => c.style.display !== "none") ? "none" : "block";
    }, 200);
  });

  moreBtn.addEventListener("click", () => load(true));

  // Refresh the build-time snapshot with live data.
  load(false);
</script>

<style>
  .radar-head { margin-bottom: 1.5rem; }
  .page-title { font-size: 1.35rem; font-weight: 700; margin: 0 0 0.5rem; }
  .page-desc { color: var(--color-text-secondary); font-size: 0.9rem; margin: 0 0 0.75rem; line-height: 1.6; }
  .stat-row { display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; font-size: 0.8rem; color: var(--color-text-muted); }
  .stat-row strong { color: var(--color-primary); font-size: 0.95rem; }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--color-text-disabled); }
  .source-note { font-size: 0.75rem; color: var(--color-text-muted); margin: 0.5rem 0 0; }
  .source-note a { color: var(--color-primary); text-decoration: none; }
  .source-note a:hover { text-decoration: underline; }

  .toolbar { margin-bottom: 1rem; }
  .category-tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.875rem; }
  .cat-tab {
    font-size: 0.78rem; padding: 0.3rem 0.7rem; border-radius: var(--radius-full);
    border: 1px solid var(--color-border); background: var(--color-card);
    color: var(--color-text-secondary); cursor: pointer; transition: all var(--transition-base);
  }
  .cat-tab:hover { border-color: rgba(var(--color-primary-rgb), 0.4); color: var(--color-primary); }
  .cat-tab.active { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
  .cat-n { opacity: 0.7; font-size: 0.7rem; }
  .search-row { display: flex; align-items: center; gap: 0.75rem; }
  #radar-search {
    flex: 1; max-width: 420px; padding: 0.5rem 0.875rem; font-size: 0.85rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-full);
    background: var(--color-card); color: var(--color-text); outline: none;
    transition: border-color var(--transition-base);
  }
  #radar-search:focus { border-color: var(--color-primary); }
  .result-count { font-size: 0.75rem; color: var(--color-text-muted); }

  .radar-list { display: flex; flex-direction: column; gap: 0.625rem; }
  .deal-card {
    background: var(--color-card); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-xs);
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-base);
  }
  .deal-card:hover { border-color: rgba(var(--color-primary-rgb), 0.3); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .deal-body { padding: 0.85rem 1.1rem; }
  .deal-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-size: 0.72rem; color: var(--color-text-muted); margin-bottom: 0.4rem; }
  .deal-cat { color: var(--color-primary); font-weight: 600; }
  .badge-free { background: rgba(34, 197, 94, 0.12); color: #16a34a; padding: 0.05rem 0.4rem; border-radius: var(--radius-full); font-weight: 600; }
  .deal-price { color: #e11d48; font-weight: 600; }
  .deal-card h2 { font-size: 0.95rem; font-weight: 700; line-height: 1.5; margin: 0 0 0.35rem; }
  .deal-card h2 a { color: var(--color-text); text-decoration: none; transition: color var(--transition-base); }
  .deal-card h2 a:hover { color: var(--color-primary); }
  .deal-desc { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.6; margin: 0 0 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .deal-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .deal-tag { font-size: 0.7rem; color: var(--color-text-muted); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-full); padding: 0.05rem 0.45rem; }
  .deal-codes { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.4rem; }
  .deal-codes code { font-size: 0.72rem; background: rgba(var(--color-primary-rgb), 0.08); color: var(--color-primary); padding: 0.1rem 0.45rem; border-radius: var(--radius-sm); }

  .empty { text-align: center; color: var(--color-text-muted); padding: 2rem 0; font-size: 0.85rem; }
  .load-more-wrap { display: flex; justify-content: center; padding: 1.25rem 0 0.5rem; }
  .load-more {
    padding: 0.5rem 1.5rem; font-size: 0.85rem; border-radius: var(--radius-full);
    border: 1px solid var(--color-border); background: var(--color-card); color: var(--color-text-secondary);
    cursor: pointer; transition: all var(--transition-base);
  }
  .load-more:hover:not(:disabled) { border-color: var(--color-primary); color: var(--color-primary); }
  .load-more:disabled { opacity: 0.55; cursor: default; }

  @media (max-width: 640px) {
    .page-desc { font-size: 0.83rem; }
    .deal-body { padding: 0.75rem 0.875rem; }
    .deal-card h2 { font-size: 0.9rem; }
  }
</style>
