---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RightSidebar from "@/components/RightSidebar.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const posts = (await getCollection("posts-en", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 6);
---
<Layout locale="en" title={`Page Not Found | ${SITE.titleEn}`} description="The page you're looking for doesn't exist or has been moved.">
  <Header locale="en" />
  <div class="layout">
    <main>
      <div class="not-found">
        <div class="error-code" role="img" aria-label="404">
          <span class="digit">4</span>
          <span class="zero" aria-hidden="true"></span>
          <span class="digit">4</span>
        </div>
        <h1>Page Not Found</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>
        <div class="search-box-wrap">
          <button type="button" class="search-btn-404" data-search-trigger aria-label="Search posts">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" />
            </svg>
            <span>Search posts... (Ctrl+K)</span>
          </button>
        </div>
        <a href="/en/" class="back-home">← Back to Home</a>
        {posts.length > 0 && (
          <div class="recommend">
            <h3>🔥 Popular Posts</h3>
            <ul>
              {posts.map((post) => (
                <li>
                  <a href={`/en/article/${post.id}`}>
                    <span class="title">{post.data.title}</span>
                    <span class="date">{post.data.pubDatetime.toLocaleDateString("en-US")}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </main>
    <RightSidebar locale="en" />
  </div>
  <Footer locale="en" />
</Layout>

<style>
  .not-found {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .error-code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
    font-weight: 800;
    font-size: clamp(3.5rem, 15vw, 6rem);
    line-height: 1;
  }
  .digit {
    font-size: inherit;
    line-height: 1;
  }
  .zero {
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    border: 0.07em solid currentColor;
    border-radius: 50%;
    box-sizing: border-box;
    animation: pulse 2.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.92); opacity: 0.7; }
  }
  .not-found h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .not-found > p {
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
  .search-box-wrap {
    max-width: 420px;
    margin: 0 auto 2rem;
  }
  .search-btn-404 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;
  }
  .search-btn-404:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 14%, transparent);
  }
  .back-home {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--color-primary);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity .2s ease;
  }
  .back-home:hover {
    opacity: 0.9;
  }
  .recommend {
    margin-top: 3rem;
    text-align: left;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .recommend h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .recommend ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .recommend a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color .2s ease;
    gap: 1rem;
  }
  .recommend a:hover {
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }
  .recommend .title {
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .recommend .date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
</style>
