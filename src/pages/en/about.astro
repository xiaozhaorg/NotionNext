---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RightSidebar from "@/components/RightSidebar.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---
<Layout
  locale="en"
  title={`About | ${SITE.titleEn}`}
  description={SITE.descriptionEn}
>
  <Header locale="en" />
  <div class="layout">
    <main>
      <article class="about-card">
        <header class="about-header">
          <h1 class="page-title">👋 About Me</h1>
          <p class="about-subtitle">{SITE.descriptionEn}</p>
        </header>

        <section class="about-section">
          <h2>🧑‍💻 Who am I</h2>
          <p>
            Hi, I'm Xiaozha, a developer who loves tinkering with tech.
            This blog documents my practices and lessons learned in AI tools,
            cloud computing, self-hosting, and open-source applications.
          </p>
        </section>

        <section class="about-section">
          <h2>📌 What I Write About</h2>
          <ul class="about-list">
            <li>🤖 AI Tools & LLMs: Tutorials and reviews of the latest models</li>
            <li>☁️ Cloud & Cloudflare Ecosystem: Pages, Workers, R2, Tunnel hands-on</li>
            <li>🏠 Self-Hosting: Jellyfin, Immich, n8n, Mealie and more open-source guides</li>
            <li>🎁 Free Resources: Domain deals, GitHub Student Pack, free API credits</li>
          </ul>
        </section>

        <section class="about-section">
          <h2>📮 Contact</h2>
          <ul class="about-list contact-list">
            <li>📧 Email: <a href="mailto:mail@xiaozha.org">mail@xiaozha.org</a></li>
            {SITE.social.github && (
              <li>🐙 GitHub: <a href={SITE.social.github} target="_blank" rel="noopener">{SITE.social.github}</a></li>
            )}
            <li>📡 RSS: <a href={SITE.social.rss}>Subscribe</a></li>
          </ul>
        </section>

        <section class="about-section">
          <h2>📜 License</h2>
          <p>
            Articles on this site are licensed under CC BY-NC-SA 4.0 unless otherwise stated.
          </p>
        </section>
      </article>
    </main>
    <RightSidebar locale="en" />
  </div>
  <Footer locale="en" />
</Layout>

<style>
  .about-card {
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow-xs);
  }
  .about-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
    color: var(--color-text);
  }
  .about-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  .about-section {
    margin-bottom: 1.5rem;
  }
  .about-section h2 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    color: var(--color-text);
  }
  .about-section p {
    line-height: 1.8;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
  .about-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .about-list li + li {
    margin-top: 0.25rem;
  }
  .about-list a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-primary);
  }
  .about-list a:hover {
    border-bottom-style: solid;
  }
</style>
