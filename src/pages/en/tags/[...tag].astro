---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RightSidebar from "@/components/RightSidebar.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { t } from "@/locales/ui";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts-en", ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((tagName) => tagSet.add(tagName)));
  return [
    { params: { tag: undefined } }, // /en/tags/ 标签聚合页
    ...[...tagSet].map((tagName) => ({ params: { tag: tagName } })),
  ];
}

const { tag } = Astro.params;
const posts = (await getCollection("posts-en", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);

// 统计每个标签的文章数
const tagMap = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((tagName) => tagMap.set(tagName, (tagMap.get(tagName) ?? 0) + 1)));
const allTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);

// 过滤当前标签的文章（tag 为空时显示全部）
const filtered = tag
  ? posts.filter((p) => p.data.tags.includes(tag as string))
  : posts;

const title = tag ? `Tag: ${tag} | ${SITE.titleEn}` : `All Tags | ${SITE.titleEn}`;
const desc = tag
  ? `All posts tagged "${tag}", ${filtered.length} posts`
  : `Browse all tags, ${allTags.length} tags, ${posts.length} posts`;
---
<Layout locale="en" title={title} description={desc}>
  <Header locale="en" />
  <div class="layout">
    <main>
      {!tag ? (
        <>
          <h1 class="page-title">{t("en", "tags_all")}</h1>
          <p class="tag-total">{t("en", "tags_count").replace("{count}", String(allTags.length)).replace("{total}", String(posts.length))}</p>
          <div class="tags-grid">
            {allTags.map(([tagName, count]) => (
              <a href={`/en/tags/${tagName}`} class="tag-card">
                <span class="tag-name">#{tagName}</span>
                <span class="tag-count">{t("en", "tag_posts").replace("{count}", String(count))}</span>
              </a>
            ))}
          </div>
        </>
      ) : (
        <>
          <div class="tag-header">
            <a href="/en/tags/" class="back-link">{t("en", "tags_back")}</a>
            <h1 class="page-title">#{tag}</h1>
            <p class="tag-total">{t("en", "tag_posts").replace("{count}", String(filtered.length))}</p>
          </div>
          <div class="post-list">
            {filtered.map((post) => (
              <Card post={post} locale="en" />
            ))}
          </div>
        </>
      )}
    </main>
    <RightSidebar locale="en" />
  </div>
  <Footer locale="en" />
</Layout>

<style>
  .page-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .tag-total {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .tag-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    transition: all .2s ease;
  }
  .tag-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -10px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }
  .tag-name {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .tag-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  .tag-header {
    margin-bottom: 1.5rem;
  }
  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    transition: color .2s ease;
  }
  .back-link:hover {
    color: var(--color-primary);
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
