---
import { getCollection } from "astro:content";
import { t, type Locale } from "@/locales/ui";

type Props = { locale?: Locale };
const { locale = "zh" } = Astro.props;

const posts = locale === "en"
  ? await getCollection("posts-en", ({ data }) => !data.draft)
  : await getCollection("posts", ({ data }) => !data.draft);

const recentPosts = [...posts]
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 6);

// 标签云：统计每个标签的文章数
const tagMap = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((tag) => tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1)));
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 15);

// 按标签数量分级，用于不同字号
const maxCount = Math.max(...tags.map(([, c]) => c), 1);
const getTagSize = (count: number) => {
  const ratio = count / maxCount;
  if (ratio > 0.7) return "lg";
  if (ratio > 0.4) return "md";
  return "sm";
};

const prefix = locale === "en" ? "/en" : "";
---
<aside class="right-sidebar">
  {/* 热门文章 */}
  <div class="widget">
    <div class="widget-header">
      <span class="widget-icon">🔥</span>
      <h3>{t(locale, "sidebar_hot")}</h3>
    </div>
    <ol class="recent-posts">
      {recentPosts.map((post, i) => (
        <li class="rank-item">
          <span class:list={["rank-num", `rank-${i + 1}`]}>{i + 1}</span>
          <a href={`${prefix}/article/${post.id}`} class="rank-title">{post.data.title}</a>
        </li>
      ))}
    </ol>
  </div>

  {/* 标签云 */}
  <div class="widget">
    <div class="widget-header">
      <span class="widget-icon">🏷️</span>
      <h3>{t(locale, "sidebar_tags")}</h3>
      <a href={`${prefix}/tags/`} class="widget-more">{t(locale, "sidebar_all_tags")}</a>
    </div>
    <div class="tags-cloud">
      {tags.map(([tag, count]) => (
        <a href={`${prefix}/tags/${tag}`} class:list={["tag-item", `tag-${getTagSize(count)}`]}>
          <span class="tag-hash">#</span>{tag}
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</aside>

<style>
  .right-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* 通用 widget */
  .widget {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.125rem;
    box-shadow: var(--shadow-xs);
    transition: box-shadow var(--transition-base);
  }
  .widget:hover {
    box-shadow: var(--shadow-sm);
  }
  .widget-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }
  .widget-icon {
    font-size: 0.9rem;
  }
  .widget-header h3 {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0;
    flex: 1;
    color: var(--color-text);
  }
  .widget-more {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }
  .widget-more:hover {
    color: var(--color-primary);
  }

  /* 排行榜 */
  .recent-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .rank-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .rank-num {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
  }
  .rank-1 {
    background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
    color: #fff;
  }
  .rank-2 {
    background: linear-gradient(135deg, #ffa94d, #ff8c42);
    color: #fff;
  }
  .rank-3 {
    background: linear-gradient(135deg, #ffd43b, #fab005);
    color: #fff;
  }
  .rank-title {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    transition: color var(--transition-base);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rank-title:hover {
    color: var(--color-primary);
  }

  /* 标签云 */
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: all var(--transition-base);
  }
  .tag-item:hover {
    background: rgba(var(--color-primary-rgb), 0.1);
    border-color: rgba(var(--color-primary-rgb), 0.3);
    color: var(--color-primary);
    transform: translateY(-1px);
  }
  .tag-lg {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .tag-md {
    font-size: 0.78rem;
  }
  .tag-hash {
    color: var(--color-text-muted);
    margin-right: 0.1rem;
  }
  .tag-count {
    margin-left: 0.25rem;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    padding: 0 0.25rem;
    background: var(--color-border);
    border-radius: var(--radius-full);
  }
</style>
