---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";
import { t, type Locale } from "@/locales/ui";

type Props = { post: CollectionEntry<"posts">; pinned?: boolean; locale?: Locale };
const { post, pinned = false, locale = "zh" } = Astro.props;
const { data, id } = post;
const urlPrefix = locale === "en" ? "/en/article" : "/article";
const url = `${urlPrefix}/${id}`;
const tagPrefix = locale === "en" ? "/en/tags" : "/tags";
const dateLocale = locale === "en" ? "en-US" : "zh-CN";
const pinnedText = locale === "en" ? "📌 Pinned" : "📌 置顶";

// 阅读时长估算（中文按字符数，英文按词数）
const wordCount = post.body?.length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 400));

// 基于标题 hash 生成稳定的渐变色（无封面图时用）
function hashStr(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
  }
  return Math.abs(h);
}
const gradients = [
  ["#667eea", "#764ba2"],
  ["#f093fb", "#f5576c"],
  ["#4facfe", "#00f2fe"],
  ["#43e97b", "#38f9d7"],
  ["#fa709a", "#fee140"],
  ["#30cfd0", "#330867"],
  ["#a8edea", "#fed6e3"],
  ["#ff9a9e", "#fecfef"],
  ["#ffecd2", "#fcb69f"],
  ["#5ee7df", "#b490ca"],
  ["#c471f5", "#fa71cd"],
  ["#48c6ef", "#6f86d6"],
];
const idx = hashStr(data.title) % gradients.length;
const [c1, c2] = gradients[idx];
const gradientStyle = `background: linear-gradient(135deg, ${c1} 0%, ${c2} 100%)`;

// 取标题首字作为占位文字
const placeholderText = data.title.charAt(0);
// 封面图 alt：优先用描述性 coverAlt，回退到标题
const coverAlt = data.coverAlt || data.title;

// 生成 WebP 路径：/images/xxx.jpg → /images/xxx.webp
const webpSrc = data.ogImage
  ? data.ogImage.replace(/\.(jpe?g|png)$/i, ".webp")
  : "";
const hasWebp = webpSrc !== data.ogImage;
---
<article class="post-card">
  <a href={url} class="post-thumb" aria-label={data.title}>
    {data.ogImage ? (
      <picture>
        {hasWebp && <source srcset={webpSrc} type="image/webp" />}
        <img
          src={data.ogImage}
          alt={coverAlt}
          class="post-thumb-img"
          width="220"
          height="138"
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none';this.parentElement.nextElementSibling.style.display='flex'"
        />
      </picture>
    ) : (
      <div class="post-thumb-placeholder" style={gradientStyle}>
        <span>{placeholderText}</span>
      </div>
    )}
    {data.ogImage && (
      <div class="post-thumb-placeholder post-thumb-fallback" style={`${gradientStyle};display:none`}>
        <span>{placeholderText}</span>
      </div>
    )}
    {pinned && <span class="pinned-badge">{pinnedText}</span>}
  </a>

  <div class="post-card-body">
    <div class="post-meta-row">
      <time>{data.pubDatetime.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })}</time>
      <span class="dot"></span>
      <span>{t(locale, "card_reading_time").replace("{min}", String(readingTime))}</span>
      {data.category && (
        <>
          <span class="dot"></span>
          <span class="category">{data.category}</span>
        </>
      )}
    </div>

    <h2><a href={url}>{data.title}</a></h2>
    <p class="post-desc">{data.description}</p>

    {data.tags.length > 0 && (
      <div class="post-tags">
        {data.tags.slice(0, 3).map((tag) => (
          <a href={`${tagPrefix}/${tag}`} class="tag-item">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition: transform var(--transition-smooth),
      box-shadow var(--transition-smooth),
      border-color var(--transition-base);
  }
  .post-card:hover {
    border-color: rgba(var(--color-primary-rgb), 0.3);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  /* 左侧缩略图 */
  .post-thumb {
    flex-shrink: 0;
    position: relative;
    width: 220px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
    align-self: stretch;
  }
  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.05em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    transition: transform 0.5s var(--ease-out);
  }
  .post-card:hover .post-thumb-img,
  .post-card:hover .post-thumb-placeholder {
    transform: scale(1.06);
  }
  .pinned-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* 右侧内容 */
  .post-card-body {
    flex: 1;
    min-width: 0;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.45rem;
    flex-wrap: wrap;
  }
  .post-meta-row .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-text-disabled);
  }
  .post-meta-row .category {
    color: var(--color-primary);
    font-weight: 500;
  }

  .post-card h2 {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 0.45rem;
    color: var(--color-text);
    transition: color var(--transition-base);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card h2 a {
    color: inherit;
  }
  .post-card:hover h2 {
    color: var(--color-primary);
  }

  .post-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  /* 响应式：移动端缩略图缩小 */
  @media (max-width: 640px) {
    .post-card {
      gap: 0.75rem;
    }
    .post-thumb {
      width: 120px;
    }
    .post-thumb-placeholder {
      font-size: 1.5rem;
    }
    .post-card-body {
      padding: 0.75rem 0.875rem;
    }
    .post-card h2 {
      font-size: 0.95rem;
    }
    .post-desc {
      display: none;
    }
  }
</style>
