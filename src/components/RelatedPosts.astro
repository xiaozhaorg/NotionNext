---
import { getCollection } from "astro:content";
import { t, type Locale } from "@/locales/ui";

type Props = {
  currentId: string;
  tags: string[];
  locale?: Locale;
  /** 推荐条数，默认 4 */
  limit?: number;
};

const { currentId, tags, locale = "zh", limit = 4 } = Astro.props;

const collection = locale === "en" ? "posts-en" : "posts";
const candidates = (await getCollection(collection, ({ data }) => !data.draft)).filter(
  (p) => p.id !== currentId
);

const urlPrefix = locale === "en" ? "/en/article" : "/article";

// 相关度用 IDF 加权：稀有共享标签比泛滥标签更有区分度。
// 「Tutorial」出现在 52 篇里，共享它说明不了什么；「MCP」只有 2 篇，共享它强相关。
const total = candidates.length + 1;
const df = new Map<string, number>();
candidates.forEach((p) => p.data.tags.forEach((tg) => df.set(tg, (df.get(tg) ?? 0) + 1)));
const weightOf = (tg: string) => Math.log(total / ((df.get(tg) ?? 0) + 1)) + 1;

const scored = candidates
  .map((post) => {
    const shared = post.data.tags.filter((tg) => tags.includes(tg));
    return { post, shared, score: shared.reduce((s, tg) => s + weightOf(tg), 0) };
  })
  .filter((x) => x.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDatetime.getTime() - a.post.data.pubDatetime.getTime()
  );

const related = scored.slice(0, limit);

// 标签太少导致凑不满时，用最新文章补足，避免区块消失导致布局跳动
if (related.length < limit) {
  const picked = new Set(related.map((r) => r.post.id));
  for (const post of [...candidates].sort(
    (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
  )) {
    if (related.length >= limit) break;
    if (picked.has(post.id)) continue;
    related.push({ post, shared: [], score: 0 });
    picked.add(post.id);
  }
}

// 每张卡片展示的共享标签：取权重最高的至多 2 个
const topShared = (shared: string[]) =>
  [...shared].sort((a, b) => weightOf(b) - weightOf(a)).slice(0, 2);
---

{related.length > 0 && (
  <section class="related" aria-label={t(locale, "related_title")}>
    <div class="section-title">
      <span class="title-bar"></span>
      <h2>{t(locale, "related_title")}</h2>
    </div>
    <div class="related-grid">
      {related.map(({ post, shared }) => (
        <a href={`${urlPrefix}/${post.id}/`} class="related-card">
          <h3>{post.data.title}</h3>
          {shared.length > 0 && (
            <div class="related-tags">
              {topShared(shared).map((tg) => (
                <span class="related-tag">#{tg}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }
  .title-bar {
    width: 4px;
    height: 1.1rem;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
  }
  .section-title h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .related-card {
    display: block;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    text-decoration: none;
    transition: border-color var(--transition-base),
      background-color var(--transition-base),
      transform var(--transition-base);
  }
  .related-card:hover {
    border-color: rgba(var(--color-primary-rgb), 0.4);
    background-color: color-mix(in srgb, var(--color-primary) 5%, var(--color-bg));
    transform: translateY(-2px);
  }

  .related-card h3 {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-base);
  }
  .related-card:hover h3 {
    color: var(--color-primary);
  }

  .related-tags {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }
  .related-tag {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.05rem 0.4rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
