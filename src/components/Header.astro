---
import { SITE } from "@/config";

const nav = [
  { label: "首页", href: "/", icon: "home" },
  { label: "标签", href: "/tags/", icon: "tag" },
  { label: "归档", href: "/tags/", icon: "archive" },
  { label: "关于", href: "/about/", icon: "user" },
];

// 当前路径用于 active 高亮
const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---
<header class="header">
  <div class="header-inner">
    <a href="/" class="header-logo" aria-label={SITE.title}>
      <span class="logo-icon">
        <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" width="28" height="28">
          <defs>
            <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#4f6df5" />
              <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#logoGrad)" />
          <path d="M10 12h12M10 16h8M10 20h12" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="logo-text">{SITE.title}</span>
    </a>

    <nav class="header-nav">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-item", { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <button id="search-trigger" class="search-trigger" data-search-trigger aria-label="搜索">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <span class="search-kbd">⌘K</span>
      </button>
    </div>
  </div>
</header>

<script>
  // 主题切换
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--glass-bg);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.625rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .logo-icon {
    display: flex;
    align-items: center;
    filter: drop-shadow(0 2px 6px rgba(var(--color-primary-rgb), 0.3));
  }
  .logo-text {
    font-size: 1.05rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.01em;
  }

  /* 导航胶囊 */
  .header-nav {
    display: flex;
    gap: 0.25rem;
    flex: 1;
  }
  .nav-item {
    position: relative;
    padding: 0.4rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
  }
  .nav-item:hover {
    color: var(--color-text);
    background: rgba(var(--color-primary-rgb), 0.06);
  }
  .nav-item.active {
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
    font-weight: 600;
  }

  /* 右侧操作 */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .theme-toggle,
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.375rem 0.625rem;
    cursor: pointer;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    transition: all var(--transition-base);
  }
  .theme-toggle {
    padding: 0.4rem;
  }
  .theme-toggle:hover,
  .search-trigger:hover {
    border-color: rgba(var(--color-primary-rgb), 0.3);
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.06);
  }
  .search-kbd {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  /* 主题图标显示 */
  .icon-moon { display: block; }
  .icon-sun { display: none; }
  :global(html.dark) .icon-moon { display: none; }
  :global(html.dark) .icon-sun { display: block; }

  @media (max-width: 768px) {
    .header-inner { gap: 0.75rem; padding: 0.625rem 1rem; }
    .logo-text { display: none; }
    .search-kbd { display: none; }
    .nav-item { padding: 0.35rem 0.625rem; font-size: 0.8rem; }
  }
</style>
