---
import { SITE } from "@/config";
import { t, htmlLang, ogLocale, localeFromPath, getAltURL, type Locale } from "@/locales/ui";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  locale?: Locale;
  /**
   * 关联的另一种语言 URL（用于 hreflang，文章页用）。
   * 传 null 表示该页面没有对应的另一种语言版本（不输出反向 hreflang）；
   * 不传则按路径自动推导（/xxx ↔ /en/xxx）。
   */
  altURL?: string | null;
  /** 禁止搜索引擎收录本页（404 等错误页用），默认 false */
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  publishedTime,
  tags,
  locale,
  altURL,
  noindex = false,
} = Astro.props;

// 自动推断 locale
const currentLocale: Locale = locale ?? localeFromPath(Astro.url.pathname);
const isEn = currentLocale === "en";

// 根据locale设置站点信息和SEO
const siteTitle = isEn ? SITE.titleEn : SITE.title;
const siteDesc = isEn ? SITE.descriptionEn : SITE.description;
const siteKeywords = isEn ? SITE.keywordsEn.join(", ") : SITE.keywords.join(", ");
const finalTitle = title ?? siteTitle;
const finalDesc = description ?? siteDesc;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site)
  : new URL("/og-default.svg", Astro.site);

// hreflang 互指（altURL === null 表示无对应语言版本，不输出该方向）
const autoAltURL =
  altURL === null ? null : altURL ?? getAltURL(Astro.url.pathname, isEn ? "zh" : "en");
const zhURL = isEn
  ? autoAltURL
    ? new URL(autoAltURL, Astro.site).toString()
    : null
  : canonicalURL.toString();
const enURL = isEn
  ? canonicalURL.toString()
  : autoAltURL
    ? new URL(autoAltURL, Astro.site).toString()
    : null;
const xDefaultURL = new URL("/", Astro.site).toString();

// JSON-LD 结构化数据
const baseSchema = {
  "@context": "https://schema.org",
};
const schemas: Record<string, unknown>[] = [];

// WebSite schema（所有页共享）
schemas.push({
  ...baseSchema,
  "@type": "WebSite",
  name: siteTitle,
  url: SITE.url,
  description: siteDesc,
  inLanguage: htmlLang(currentLocale),
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE.url}/#q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
});

if (type === "article") {
  schemas.push({
    ...baseSchema,
    "@type": "BlogPosting",
    headline: finalTitle,
    description: finalDesc,
    image: ogImage.toString(),
    datePublished: publishedTime?.toISOString(),
    dateModified: publishedTime?.toISOString(),
    author: {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
    },
    publisher: {
      "@type": "Organization",
      name: siteTitle,
      url: SITE.url,
      logo: {
        "@type": "ImageObject",
        url: new URL("/og-default.svg", Astro.site).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL.toString(),
    },
    keywords: tags?.join(", "),
    inLanguage: htmlLang(currentLocale),
  });
}

// BreadcrumbList 面包屑 JSON-LD
const pathname = Astro.url.pathname.replace(/\/$/, "");
const segments = pathname.split("/").filter(Boolean);
const homeLabel = isEn ? "Home" : "首页";
const articleLabel = isEn ? "Posts" : "文章";
const tagsLabel = isEn ? "Tags" : "标签";
const crumbs: { name: string; url: string }[] = [{ name: homeLabel, url: isEn ? "/en/" : "/" }];

let accumulated = "";
for (const seg of segments) {
  accumulated += `/${decodeURIComponent(seg)}/`;
  // 跳过 / 和 /article/ 本身作为层级
  if (seg === SITE.post.urlPrefix) {
    crumbs.push({ name: articleLabel, url: isEn ? `/en/${SITE.post.urlPrefix}/` : `/${SITE.post.urlPrefix}/` });
    continue;
  }
  if (seg === "tags") {
    crumbs.push({ name: tagsLabel, url: isEn ? "/en/tags/" : "/tags/" });
    continue;
  }
  // 具体 slug 或 tag 名
  const label = decodeURIComponent(seg).replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
  crumbs.push({ name: label, url: accumulated });
}
schemas.push({
  ...baseSchema,
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.url, Astro.site).toString(),
  })),
});
---
<!DOCTYPE html>
<html lang={htmlLang(currentLocale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- TDK -->
    <title>{finalTitle}</title>
    <meta name="title" content={finalTitle} />
    <meta name="description" content={finalDesc} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="author" content={SITE.author} />
    <meta name="copyright" content={`© ${SITE.since}-${new Date().getFullYear()} ${siteTitle}`} />
    <meta name="robots" content={noindex
      ? "noindex,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
      : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="baiduspider" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="bingbot" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang 多语言互指（Google 必须项） -->
    {zhURL && <link rel="alternate" hreflang="zh-CN" href={zhURL} />}
    {enURL && <link rel="alternate" hreflang="en" href={enURL} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={ogLocale(currentLocale)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={finalTitle} />
    <meta property="og:see_also" content={SITE.social.github} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={finalTitle} />
    <meta name="twitter:site" content="@xiaozhaorg" />
    <meta name="twitter:creator" content="@xiaozhaorg" />

    <!-- 百度 / 搜狗 / 360 专属优化 -->
    <meta name="renderer" content="webkit" />
    <meta name="force-rendering" content="webkit" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c10" />
    <meta name="application-name" content={SITE.title} />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="MobileOptimized" content="width" />
    <meta name="HandheldFriendly" content="true" />

    <!-- RSS / Sitemap -->
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- JSON-LD 结构化数据 -->
    <script
      type="application/ld+json"
      set:html={schemas.map((s) => JSON.stringify(s)).join("")}
      is:inline
    />

    <!-- 暗色模式：防闪烁，提前设置 class -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const isDark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", isDark);
        } catch (_) {}
      })();
    </script>

    <!-- 51la 站点统计 -->
    {SITE.analytics.laId && (
      <>
        <script is:inline charset="UTF-8" id="LA_COLLECT" src="https://sdk.51.la/js-sdk-pro.min.js"></script>
        <script is:inline define:vars={{ laId: SITE.analytics.laId, laCk: SITE.analytics.laCk }}>
          window.LA = window.LA || {};
          window.addEventListener("load", function () {
            try { LA.init({ id: laId, ck: laCk }); } catch (_) {}
          });
        </script>
      </>
    )}

    <!-- Cloudflare Web Analytics -->
    {SITE.analytics.cloudflareToken && (
      <script defer is:inline
        src={`https://static.cloudflareinsights.com/beacon.min.js`}
        data-cf-beacon={`{"token": "${SITE.analytics.cloudflareToken}"}`}>
      </script>
    )}

    <!-- Pagefind 静态搜索（astro-pagefind 集成会自动生成 /pagefind 资源，点击时才加载） -->
  </head>
  <body>
    <slot />

    <!-- Pagefind UI 初始化：懒加载，首次触发（点击/Ctrl+K/#q=）时才注入 CSS+JS -->
    <script is:inline>
      (function () {
        const wrap = document.getElementById("pagefind-search-ui");
        let pagefindUI = null;

        function openSearch(term) {
          if (!wrap) return;
          wrap.classList.add("active");
          // 支持 #q=xxx 直达：填入关键词并触发 Pagefind 搜索
          if (term && pagefindUI) {
            const input = wrap.querySelector(".pagefind-ui__search-input");
            if (input) {
              input.value = term;
              input.dispatchEvent(new Event("input", { bubbles: true }));
            }
          }
          // 聚焦 Pagefind 内部输入框
          setTimeout(function () {
            const pfInput = wrap.querySelector(".pagefind-ui__search-input");
            if (pfInput) {
              pfInput.focus();
              pfInput.select();
            }
          }, 60);
        }

        function closeSearch() {
          if (!wrap) return;
          wrap.classList.remove("active");
        }

        function initPagefind() {
          // PagefindUI 是全局脚本注入的构造器，非模块导入
          const PF = window["PagefindUI"];
          if (!PF || pagefindUI) return;
          pagefindUI = new PF({
            element: "#pagefind-search-ui",
            showSubResults: true,
            excerptLength: 40,
            showImages: false,
            baseUrl: "/",
          });
        }

        // 懒加载：首次调用时注入 CSS + JS，之后直接复用
        function ensureLoaded() {
          return new Promise(function (resolve) {
            if (pagefindUI) {
              resolve();
              return;
            }
            if (!document.getElementById("pagefind-ui-css")) {
              const link = document.createElement("link");
              link.id = "pagefind-ui-css";
              link.rel = "stylesheet";
              link.href = "/pagefind/pagefind-ui.css";
              document.head.appendChild(link);
            }
            if (window["PagefindUI"]) {
              initPagefind();
              resolve();
              return;
            }
            // /pagefind/pagefind-ui.js 由 astro-pagefind 注入到构建产物
            const s = document.createElement("script");
            s.src = "/pagefind/pagefind-ui.js";
            s.onload = function () {
              initPagefind();
              resolve();
            };
            s.onerror = function () {
              console.warn("[Pagefind] 搜索索引加载失败，构建后才会生成 /pagefind 资源");
              alert("搜索功能在构建后启用（dev 模式无索引）");
              resolve();
            };
            document.body.appendChild(s);
          });
        }

        // #q=xxx / #search=xxx 直达搜索（配合 JSON-LD SearchAction）
        function handleHash() {
          const m = /#(?:q|search)=([^&]+)/.exec(location.hash);
          if (m) {
            const term = decodeURIComponent(m[1].replace(/\+/g, " ")).trim();
            if (term) {
              ensureLoaded().then(function () {
                openSearch(term);
              });
            }
          }
        }

        // 所有带 data-search-trigger 的元素：点击即打开搜索
        document.querySelectorAll("[data-search-trigger]").forEach(function (el) {
          el.addEventListener("click", function (e) {
            e.preventDefault();
            ensureLoaded().then(function () {
              openSearch();
            });
          });
        });

        // 点击 UI 外部关闭（避开触发器自身）
        document.addEventListener("click", function (e) {
          if (
            wrap &&
            wrap.classList.contains("active") &&
            !wrap.contains(e.target) &&
            !e.target.closest("[data-search-trigger]")
          ) {
            closeSearch();
          }
        });

        // 快捷键：Ctrl/Cmd + K 打开，ESC 关闭
        document.addEventListener("keydown", function (e) {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            ensureLoaded().then(function () {
              openSearch();
            });
          }
          if (e.key === "Escape") {
            closeSearch();
          }
        });

        // 支持搜索引擎携带 #q= 直达
        window.addEventListener("hashchange", handleHash);
        handleHash();
      })();
    </script>

    <!-- Pagefind UI 挂载点（相对定位在搜索框下方） -->
    <div id="pagefind-search-ui"></div>
  </body>
</html>

<style is:global>
  /* Pagefind UI 弹出层样式 */
  #pagefind-search-ui {
    position: fixed;
    inset: 0;
    display: none;
    z-index: 100;
    background: color-mix(in srgb, #000 40%, transparent);
    backdrop-filter: blur(2px);
    padding: 5vh 1rem;
  }
  #pagefind-search-ui.active {
    display: block;
  }
  #pagefind-search-ui .pagefind-ui {
    max-width: 720px;
    margin: 0 auto;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.3);
    color: var(--color-text);
  }
  #pagefind-search-ui .pagefind-ui::after {
    content: "按 ESC 关闭 · Ctrl+K 打开";
    display: block;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
  }
  /* 覆盖 pagefind 默认主题色为站点 CSS 变量 */
  #pagefind-search-ui .pagefind-ui {
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-text-strong: var(--color-text);
    --pagefind-ui-text-muted: var(--color-text-muted);
    --pagefind-ui-background: var(--color-card);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-border-strong: var(--color-primary);
  }
</style>
